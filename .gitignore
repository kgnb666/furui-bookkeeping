# ===== 敏感文件：绝对不能提交 =====
# 根目录 .env 存放部署用的数据库口令与 JWT 密钥
.env
.env.*
!.env.example

# 部署脚本配置（服务器地址、SSH 私钥路径）
deploy-config.json

# ===== 构建产物 =====
# 后端（jar / class / 测试报告）
backend/target/
# 前端（Flutter 构建输出、依赖缓存，frontend/.gitignore 已覆盖，这里再兜一层）
frontend/build/
frontend/.dart_tool/
frontend/.flutter-plugins-dependencies

# ===== 日志 =====
*.log

# ===== 编辑器 / 系统 =====
.idea/
.vscode/
*.iml
*.ipr
*.iws
.DS_Store
Thumbs.db
desktop.ini

# ===== 其他 =====
# 打包出来的安装包不入库
app-release.apk
*.apk
