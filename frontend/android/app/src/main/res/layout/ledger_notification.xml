<?xml version="1.0" encoding="utf-8"?>
<!--
  常驻通知的自定义布局。
  说明：Android 通知的背景色由系统控制，普通通知无法改背景色；
  要达到「预算充足=绿、预算告急=红」的效果，只能用自定义布局（RemoteViews）
  自己画背景。背景色在 Kotlin 侧通过 setInt(rootId, "setBackgroundColor", color) 设置。
  RemoteViews 只支持有限的控件，这里只用了 LinearLayout / TextView / ProgressBar。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ledger_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/ledger_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/ledger_text"
        android:text="福瑞记账 · 预算充足" />

    <TextView
        android:id="@+id/ledger_today"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="13sp"
        android:maxLines="1"
        android:textColor="@color/ledger_text_sub"
        android:text="今日 支出 ¥0.00 · 收入 ¥0.00" />

    <!-- 三个进度条各用一种颜色，按状态切换可见性；
         这样不依赖 API 31 才有的 setColorStateList，minSdk 24 也能用。 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp">

        <ProgressBar
            android:id="@+id/ledger_bar_ok"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/ledger_ok"
            android:progressBackgroundTint="#33000000" />

        <ProgressBar
            android:id="@+id/ledger_bar_warn"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/ledger_warn"
            android:progressBackgroundTint="#33000000"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/ledger_bar_danger"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/ledger_danger"
            android:progressBackgroundTint="#33000000"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/ledger_budget"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:textSize="13sp"
        android:maxLines="1"
        android:textColor="@color/ledger_text"
        android:text="本月预算 ¥0 · 已用 0%" />

    <TextView
        android:id="@+id/ledger_balance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="13sp"
        android:maxLines="1"
        android:textColor="@color/ledger_text_sub"
        android:text="本月结余 ¥0.00" />
</LinearLayout>
